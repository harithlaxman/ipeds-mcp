# Copy this file to .env and fill in your real values. .env is gitignored.

# Postgres connection URL used by ingest.py (and the MCP server).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ipeds_db

# Azure OpenAI — used by postprocess.py to summarize table descriptions.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Optional; defaults to 2024-10-21 if unset.
AZURE_OPENAI_API_VERSION=2024-10-21
